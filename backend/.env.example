# Copy to backend/.env for local development. Never commit the real .env.

# True locally, False in production
DEBUG=True

# Any long random string (Render can generate one)
SECRET_KEY=change-me-to-a-long-random-string

# Comma-separated hostnames. Render's own hostname is added automatically.
ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated frontend URLs allowed to call the API (no trailing slash)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Comma-separated https origins of this backend, needed for the /admin login in production
CSRF_TRUSTED_ORIGINS=

# Optional Postgres URL (Supabase, Render, ...). Empty = local SQLite file.
DATABASE_URL=

# Sunbird AI token for the Luganda voice. Empty = browser fallback voice.
SUNBIRD_API_TOKEN=

# Optional overrides (defaults shown)
# SUNBIRD_TTS_URL=https://api.sunbird.ai/tasks/audio/speech
# SUNBIRD_TTS_LANGUAGE=lug
# SUNBIRD_TTS_VOICE=
# TTS_CACHE_DIR=tts_cache
# MODEL_PATH=../tuned_best_svm_model.pkl
